# NativeFrames Environment Configuration
# Copy this file to .env and fill in your real values.

# Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=1

# Database (Railway internal URL — only works when deployed on Railway)
# For local development, use the public proxy URL from Railway dashboard
DATABASE_URL=mysql+pymysql://root:YOUR_DB_PASSWORD@YOUR_DB_HOST:YOUR_DB_PORT/railway

# Or configure individually:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=railway

# Admin credentials (used only for initial setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-password

# Uploads directory (absolute or relative path)
UPLOAD_FOLDER=uploads

# Max upload size in MB
MAX_UPLOAD_MB=500

# Timezone (for display purposes)
TIMEZONE=Asia/Kolkata
